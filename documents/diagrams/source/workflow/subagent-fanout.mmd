    classDef external fill:#f0f9ff,stroke:#0ea5e9,color:#0c4a6e
    classDef agent fill:#475569,stroke:#334155,color:#fff

    class MAIN_AG agent
    class DECIDE,R_ARCH,R_RES,R_PAR decision
    class INLINE gate
    class SPAWN,MERGE core
    class SA_ARCH,SA_RES,SA_PAR external
    class NOTE optional
