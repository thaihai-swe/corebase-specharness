    classDef note fill:#f9fafb,stroke:#e5e7eb,color:#374151

    class MAIN_AG,MERGE main
    class SA_ARCH,SA_RES,SA_PAR subagent
    class R_ARCH,R_RES,R_PAR report
    class DECIDE decision
    class INLINE inline
    class SPAWN spawn
