flowchart TD
    %% CoreBase SpecHarness Onboarding Flow — implementation authority:
    %% WORKFLOW.md §2–§3, starter-init/SKILL.md, install.sh, and cli.py init
    %% Palette: documents/diagrams/source/_shared/palette.md

    START([Untailored Project]):::terminal --> INST["install.sh<br/>Copies kit-owned overwrite files<br/>Seeds missing copyIfMissing files<br/>Mirrors skills/ to .agent/skills/<br/>Runs installed doctor"]:::core
    INST --> INIT_CMD["python3 corebase-specharness/scripts/core/cli.py init<br/>Scaffolds missing directories and seed stubs<br/>Reports onboarding readiness and stack markers"]:::core
    INIT_CMD --> MODE{starter-init mode}:::decision

    MODE -->|fresh-init| FRESH["Empty or uninitialized workspace<br/>scaffold · archaeology sweep · memory pre-fill"]:::core
    MODE -->|resync-drift| RESYNC["harness-config.yaml already exists<br/>read-only archaeology diff<br/>do not overwrite adopter edits"]:::core

    FRESH --> DETECT
    RESYNC --> DETECT
    DETECT{Greenfield or Brownfield?}:::decision

    DETECT -->|Greenfield| GREEN["Greenfield<br/>Empty or kit-only repository"]:::gate
    DETECT -->|Brownfield| BROWN["Brownfield<br/>Existing project code or tests"]:::decision

    GREEN --> GINIT["/starter-init Phase B<br/>Configure core-policies.md and project descriptors"]:::gate
    GINIT --> GMEM["Customize memory files and confirm native commands"]:::gate
    GMEM --> GFEAT["Pick first feature<br/>Route to /spec-requirements"]:::gate

    BROWN --> BARCH["/starter-init Phase A<br/>Read-only archaeology sweep via subagents<br/>Writes stack, architecture, policies, and preserved baselines"]:::decision
    BARCH --> BINIT["/starter-init Phase B<br/>Customize core-policies.md and project facts<br/>Record baseline test commands"]:::decision
    BINIT --> BSAFE["Pick small, safe first feature<br/>Route to /spec-research if behavior unknown"]:::decision

    GFEAT --> LOOP[Standard direct-skill delivery loop]:::core
    BSAFE --> LOOP
    LOOP --> SHIP([Shipped feature + KB compounded]):::terminal

    classDef terminal fill:#111827,stroke:#111827,color:#fff
    classDef core fill:#eff6ff,stroke:#2563eb,color:#1e3a8a
    classDef gate fill:#ecfdf5,stroke:#16a34a,color:#166534
    classDef decision fill:#fff7ed,stroke:#f59e0b,color:#78350f

    class START,SHIP terminal
    class INST,INIT_CMD,FRESH,RESYNC,LOOP core
    class GREEN,GINIT,GMEM,GFEAT gate
    class MODE,DETECT,BROWN,BARCH,BINIT,BSAFE decision
