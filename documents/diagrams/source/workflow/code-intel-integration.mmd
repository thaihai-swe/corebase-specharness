flowchart LR
    %% Code Intelligence Integration — external provider boundary and intent mapping
    %% Implementation authority: tool-providers.md, tool-providers-registry.json, and providers/*.md
    %% Palette: documents/diagrams/source/_shared/palette.md

    subgraph COREBASE_SPECHARNESS["CoreBase SpecHarness Project Configuration"]
        CI_CFG["corebase-specharness/project/tool-providers.md<br/>YAML frontmatter configures:<br/>providers.code-intelligence.active"]:::core
        DOCTOR["python3 corebase-specharness/scripts/core/cli.py provider-check<br/>Validates active provider availability"]:::gate
        CI_CFG --> DOCTOR
    end

    subgraph ACTIVE_PROV["Capability Routing"]
        ACTIVE{providers.code-intelligence<br/>.active value?}:::decision
        CI_CFG --> ACTIVE

        ACTIVE -->|none| NONE["No active provider<br/>Deferred status in diagnostics<br/>Use standard local search"]:::optional
        ACTIVE -->|gitnexus| GN_FILE["corebase-specharness/project/providers/<br/>gitnexus.md"]:::external
        ACTIVE -->|codebase-memory-mcp| CBM_FILE["corebase-specharness/project/providers/<br/>codebase-memory-mcp.md"]:::external
    end

    subgraph EXTERNAL["External Provider Boundary"]
        GN["GitNexus CLI<br/>(gitnexus analyze)"]:::external
        CBM["Codebase-Memory MCP server<br/>(codebase-memory-mcp index .)"]:::external
    end

    GN_FILE -.->|maps capabilities to local action| GN
    CBM_FILE -.->|maps capabilities to local action| CBM

    AGENTS["Agent Code-Intelligence Workflows<br/>Uses concept exploration, symbol context,<br/>upstream/downstream impact, and safe rename"]:::memory
    ACTIVE -->|any provider| AGENTS

    AGENTS -.->|Provider unavailable| MANUAL["Fallback:<br/>Use standard grep / read<br/>note [CI tool unavailable]"]:::optional

    classDef terminal fill:#111827,stroke:#111827,color:#fff
    classDef core fill:#eff6ff,stroke:#2563eb,color:#1e3a8a
    classDef gate fill:#ecfdf5,stroke:#16a34a,color:#166534
    classDef decision fill:#fff7ed,stroke:#f59e0b,color:#78350f
    classDef optional fill:#f8fafc,stroke:#94a3b8,color:#475569,stroke-dasharray:4 3
    classDef external fill:#f0f9ff,stroke:#0ea5e9,color:#0c4a6e
    classDef memory fill:#faf5ff,stroke:#a855f7,color:#4c1d95

    class CI_CFG core
    class DOCTOR gate
    class ACTIVE decision
    class NONE,MANUAL optional
    class GN_FILE,CBM_FILE,GN,CBM external
    class AGENTS memory
