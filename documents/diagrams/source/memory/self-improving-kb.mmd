flowchart TD
    %% Self-Improving Knowledge Loop — implementation authority:
    %% MEMORY.md §6, context-memory/SKILL.md, session handlers, and harness-maintain
    %% Palette: documents/diagrams/source/_shared/palette.md

    subgraph ACQUIRE["Evidence Acquisition"]
        IMPLEMENT["spec-implement<br/>append non-trivial `[CANDIDATE]` lessons"]:::core
        SESSION_END["cli.py session-end --feature &lt;slug&gt;<br/>--candidate / --extract-file"]:::core
        VERIFY["harness-verify Pass + verified: true<br/>write ## Post-Ship Sync heading"]:::gate
        GATE_RUNS["cli.py verify<br/>in-memory gate failure evidence"]:::decision
    end

    IMPLEMENT --> EXTRACTS
    SESSION_END --> EXTRACTS
    VERIFY --> SYNC
    GATE_RUNS --> MAINTAIN

    EXTRACTS["artifacts/features/&lt;slug&gt;/session-extracts.md<br/>## Pending Candidates · EXT-* evidence<br/>## Post-Ship Sync record"]:::memory

    subgraph SYNC_PATH["Post-Ship Sweep"]
        SYNC["/context-memory post-ship-sync<br/>read MASTER_INDEX.md and feature evidence"]:::core
        SCOPE{Change scope?}:::decision
        NARROW["Extremely narrow<br/>check learned-heuristics.md only<br/>or record no heuristic learned"]:::core
        FULL["Moderate / core<br/>classify each indexed file<br/>Updated · Untouched · Skipped"]:::core
        THRESH["Run memory-audit<br/>check configured warn / hard line thresholds"]:::core
        PROPOSAL["Threshold crossed<br/>write promotions.md proposal<br/>never auto-split or auto-promote"]:::decision
        RECORD["Append dated Post-Ship Sync record<br/>to feature session-extracts.md"]:::memory

        SYNC --> SCOPE
        SCOPE -->|narrow| NARROW --> RECORD
        SCOPE -->|moderate / core| FULL --> THRESH
        THRESH -->|threshold crossed| PROPOSAL --> RECORD
        THRESH -->|within limits| RECORD
    end

    subgraph TRIAGE_PATH["Candidate Triage"]
        TRIAGE["Read every pending candidate<br/>category · confidence · evidence"]:::core
        DEDUP["Compare with existing policies,<br/>heuristics, facts, patterns, and boundaries"]:::core
        DECIDE{Evidence-backed action}:::decision
        PROMOTE_H["Promote or merge heuristic<br/>learned-heuristics.md · LH-*"]:::gate
        PROMOTE_P["Promote project fact / boundary<br/>project-knowledge-base.md<br/>architecture.md or domain pack"]:::gate
        PROMOTE_C["Propose normative CC-* amendment<br/>core-policies.md<br/>team agreement required"]:::fail
        ROUTE_H["Harness gap → /harness-maintain<br/>Spec gap → /spec-requirements"]:::external
        DEFER["Defer<br/>retain candidate with reason"]:::optional
        DISCARD["Discard feature-local, contradicted,<br/>or duplicate noise with reason"]:::optional
        MARK["Move processed entries to ## Triaged<br/>record status, notes, linked evidence<br/>stamp triaged date"]:::memory

        EXTRACTS --> TRIAGE --> DEDUP --> DECIDE
        DECIDE -->|durable heuristic| PROMOTE_H --> MARK
        DECIDE -->|fact / pattern / boundary| PROMOTE_P --> MARK
        DECIDE -->|normative rule| PROMOTE_C --> MARK
        DECIDE -->|harness or spec gap| ROUTE_H --> MARK
        DECIDE -->|under-evidenced| DEFER --> MARK
        DECIDE -->|local / contradicted / covered| DISCARD --> MARK
    end

    RECORD --> TRIAGE

    subgraph MAINT_PATH["Harness-Informed Improvement"]
        MAINTAIN["/harness-maintain improve<br/>inspect reproducible gate failure evidence"]:::core
        DRAFT["Draft `[DRAFT]` learned heuristic<br/>no silent promotion"]:::decision
        APPROVAL{User reviews draft}:::decision
        MAINTAIN --> DRAFT --> APPROVAL
        APPROVAL -->|approved and durable| PROMOTE_H
        APPROVAL -->|not approved| DEFER
    end

    subgraph HEALTH["Memory Health &amp; Decay"]
        AUDIT["cli.py memory-audit<br/>line counts · token estimates<br/>warning / hard-cap findings"]:::core
        GATE["cli.py memory-gate<br/>mode = advisory / warn / block"]:::core
        COMPACT["Compaction mode<br/>snapshot · reduce prose 30–50%<br/>preserve headings and stable IDs"]:::core
        ARCHIVE["Decay archival<br/>tombstone LH-* in source<br/>append body to deprecated-heuristics.md"]:::optional
        VERIFY_IDS["Re-audit and compare IDs before / after"]:::gate

        MARK --> AUDIT --> GATE
        GATE -->|threshold action required| COMPACT --> VERIFY_IDS
        GATE -->|fading / superseded heuristic| ARCHIVE --> VERIFY_IDS
        GATE -->|within thresholds| FINAL
    end

    VERIFY_IDS --> FINAL
    FINAL(["Future named-skill context uses<br/>reviewed, bounded, durable memory"]):::terminal

    classDef terminal fill:#111827,stroke:#111827,color:#fff
    classDef core fill:#eff6ff,stroke:#2563eb,color:#1e3a8a
    classDef gate fill:#ecfdf5,stroke:#16a34a,color:#166534
    classDef decision fill:#fff7ed,stroke:#f59e0b,color:#78350f
    classDef optional fill:#f8fafc,stroke:#94a3b8,color:#475569,stroke-dasharray:4 3
    classDef external fill:#f0f9ff,stroke:#0ea5e9,color:#0c4a6e
    classDef memory fill:#faf5ff,stroke:#a855f7,color:#4c1d95
    classDef fail fill:#fef2f2,stroke:#ef4444,color:#7f1d1d

    class FINAL terminal
    class IMPLEMENT,SESSION_END,SYNC,NARROW,FULL,THRESH,TRIAGE,DEDUP,MAINTAIN,AUDIT,GATE,COMPACT core
    class VERIFY,PROMOTE_H,PROMOTE_P,VERIFY_IDS gate
    class GATE_RUNS,SCOPE,PROPOSAL,DECIDE,DRAFT,APPROVAL decision
    class EXTRACTS,RECORD,MARK memory
    class ROUTE_H external
    class DEFER,DISCARD,ARCHIVE optional
    class PROMOTE_C fail
