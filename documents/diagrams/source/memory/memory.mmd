flowchart TD
    %% 3-Tier Memory Architecture — implementation authority:
    %% MEMORY.md, CONTEXT_AND_MEMORY.md, core-policies.md, context-routes.yaml, and SKILL.md
    %% Palette: documents/diagrams/source/_shared/palette.md

    subgraph INSTR["Instruction Tier — Human-Curated, Durable"]
        POL["corebase-specharness/memories/repo/core-policies.md<br/>Normative rules, security policy, thresholds"]:::gate
        PKB["corebase-specharness/memories/repo/project-knowledge-base.md<br/>Durable patterns, watchouts, continuity facts"]:::gate
        HEUR["corebase-specharness/memories/repo/learned-heuristics.md<br/>Evidence-backed LH-* heuristics"]:::gate
        ADR_LOG["corebase-specharness/memories/repo/adr-log.md<br/>ADR discoverability ledger"]:::gate
    end

    subgraph AUTO["Auto Tier — Failure &amp; Health State"]
        VERIFY_LIVE["cli.py verify<br/>in-memory gate, provider, and closeout results"]:::decision
    end

    subgraph EXTR["Extracted Tier — Feature Candidates"]
        EXT["artifacts/features/&lt;slug&gt;/session-extracts.md<br/>EXT-* candidate lessons (`[CANDIDATE]`) · ## Post-Ship Sync"]:::memory
        PROMO["artifacts/features/&lt;slug&gt;/promotions.md<br/>Proposals for files crossing thresholds"]:::memory
    end

    subgraph DOMAIN["Domain Packs — Adopter-Owned"]
        DPACK["corebase-specharness/memories/domain/&lt;name&gt;/<br/>glossary · patterns · anti-patterns · boundaries"]:::external
    end

    subgraph ADR_STORE["ADR Records"]
        ADR_FILE["corebase-specharness/project/adr/ADR-NNN-&lt;slug&gt;.md<br/>Decision records generated via adr-generate"]:::decision
    end

    subgraph SESSION["Session State"]
        SESS_MD[".corebase-specharness/sessions/&lt;slug&gt;/session.md<br/>Objective · progress updates · handoff updates"]:::optional
    end

    subgraph ROUTER["Routing &amp; Diagnostic Engine"]
        ROUTES["corebase-specharness/references/context-routes.yaml<br/>Only named-skill routing authority"]:::core
        DIAG["cli.py memory-audit / memory-gate<br/>Read-only line &amp; token threshold checks"]:::core
    end

    %% Routing flow
    ROUTES -.-> POL
    ROUTES -.-> PKB
    ROUTES -.-> HEUR
    ROUTES -.-> DPACK
    ROUTES -.-> ADR_LOG
    ROUTES -.-> SESS_MD
    ROUTES -.-> EXT

    %% Promotion and triage flow
    EXT -.->|/context-memory<br/>post-ship sync &amp; extraction triage| HEUR
    EXT -.->|/context-memory triage| PKB
    EXT -.->|/context-memory triage| POL
    EXT -.->|/context-memory triage| DPACK
    VERIFY_LIVE -.->|harness-maintain improve<br/>draft heuristics for review| HEUR

    %% Writers
    VERIFY["harness-verify →<br/>## Post-Ship Sync record"]:::agent --> EXT
    VERIFY -.->|if threshold crossed| PROMO
    SESS_END["cli.py session-end --feature &lt;slug&gt;"]:::agent --> EXT
    SESS_CLI["cli.py skill-enter / session-checkpoint"]:::agent --> SESS_MD
    ADR_SKILL["spec-adr / cli.py adr-generate"]:::agent --> ADR_FILE
    ADR_SKILL --> ADR_LOG
    IMPROVE["harness-maintain improve"]:::agent --> HEUR
    DOCTOR["harness-maintain assess / cli.py doctor"]:::agent --> VERIFY_LIVE
    GATE_RUN["cli.py verify"]:::agent --> VERIFY_LIVE

    classDef terminal fill:#111827,stroke:#111827,color:#fff
    classDef core fill:#eff6ff,stroke:#2563eb,color:#1e3a8a
    classDef gate fill:#ecfdf5,stroke:#16a34a,color:#166534
    classDef decision fill:#fff7ed,stroke:#f59e0b,color:#78350f
    classDef optional fill:#f8fafc,stroke:#94a3b8,color:#475569,stroke-dasharray:4 3
    classDef external fill:#f0f9ff,stroke:#0ea5e9,color:#0c4a6e
    classDef memory fill:#faf5ff,stroke:#a855f7,color:#4c1d95
    classDef agent fill:#475569,stroke:#334155,color:#fff

    class POL,PKB,HEUR,ADR_LOG gate
    class VERIFY_LIVE,ADR_FILE decision
    class EXT,PROMO memory
    class DPACK external
    class SESS_MD optional
    class ROUTES,DIAG core
    class VERIFY,SESS_END,SESS_CLI,ADR_SKILL,IMPROVE,DOCTOR,GATE_RUN agent
