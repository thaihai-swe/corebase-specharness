    classDef assess fill:#eef2ff,stroke:#6366f1,color:#3730a3
    classDef improve fill:#fffbeb,stroke:#d97706,color:#78350f
    classDef create fill:#ecfdf5,stroke:#16a34a,color:#166534
    classDef doctor fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef diagnose fill:#fce7f3,stroke:#db2777,color:#831843
    classDef output fill:#f3f4f6,stroke:#9ca3af,color:#374151
    classDef approval fill:#fef2f2,stroke:#ef4444,color:#7f1d1d
