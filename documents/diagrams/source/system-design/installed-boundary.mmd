flowchart TB
    %% Installed Boundary — implementation authority: manifest.json + install.sh
    %% Palette: documents/diagrams/source/_shared/palette.md

    INSTALL["kit/corebase-specharness/scripts/install.sh<br/>reads kit/manifest.json"]:::core --> PACKAGE["Source package rooted at kit/<br/>paths install without a kit/ prefix"]:::gate
    PACKAGE --> TARGET["Adopter repository root<br/>project-local embedded runtime"]:::gate

    subgraph OWNERSHIP["Manifest Ownership Classes"]
        OVERWRITE["files.overwrite<br/>kit-owned payload<br/>backup existing file, then replace"]:::decision
        SEED["files.copyIfMissing<br/>adopter-owned after first copy<br/>copy only when absent"]:::memory
    end

    TARGET --> OVERWRITE
    TARGET --> SEED

    OVERWRITE --- OW_DESC["manifest.json · README.md · AGENTS.md · EXTERNAL_SKILLS.md<br/>11 skills + shared files · references/<br/>corebase-specharness/scripts/ · rules/ · CONTEXT_AND_MEMORY.md<br/>state-machine.yaml · validators"]:::decision
    SEED --- SEED_DESC["corebase-specharness/MASTER_INDEX.md<br/>project configuration and provider guides<br/>repository/domain/archive memory seeds<br/>artifacts/features/README.md"]:::memory

    AGENT_MIRROR[".agent/skills/**<br/>overwrite mirror of skills/<br/>for standard agent discovery"]:::external
    TARGET --> AGENT_MIRROR

    UNMANAGED["Paths not selected by overwrite<br/>adopter-created feature artifacts, sessions,<br/>ADRs, memory, and project code"]:::optional
    TARGET --> UNMANAGED

    SESSION[".corebase-specharness/sessions/&lt;slug&gt;/session.md<br/>created or resumed by skill-enter / session-start<br/>retained in place by session-end"]:::optional
    TARGET --> SESSION

    BACKUP[".corezero-backup-&lt;random&gt;/<br/>mktemp overwrite backup · not auto-gitignored"]:::optional
    INSTALL --> BACKUP

    VALIDATE["Non-dry-run closeout<br/>chmod shipped scripts · run installed doctor"]:::core
    INSTALL --> VALIDATE

    DOC["documents/maintainer/ and documents/diagrams/<br/>source-repository documentation only"]:::optional
    DOC -.->|not selected by manifest| TARGET

