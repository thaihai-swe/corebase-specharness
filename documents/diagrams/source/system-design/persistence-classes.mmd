flowchart TD
    %% Persistence Classes — implementation authority: manifest.json, handlers, skills, and context_state.py

    subgraph KIT["Kit-Owned Installed Payload"]
        KIT_FILES["manifest.json · README.md · AGENTS.md · EXTERNAL_SKILLS.md<br/>skills/ · references/ · corebase-specharness/scripts/<br/>corebase-specharness/rules/ · CONTEXT_AND_MEMORY.md · state-machine.yaml<br/>files.overwrite replaces these after backup"]:::kit
    end

    subgraph SEEDS["Adopter-Owned Seeds"]
        INDEX["corebase-specharness/MASTER_INDEX.md"]:::seed
        PROJECT["corebase-specharness/project/<br/>architecture · tech stack · product sense · constraints · glossary<br/>harness-config.yaml · tool-providers.md and guides"]:::seed
        MEMORY["corebase-specharness/memories/<br/>repository memory · domain pack seeds · archive seed"]:::memory
        FEATURE_README["artifacts/features/README.md"]:::seed
    end

    subgraph FEATURE["Durable Feature Evidence"]
        ART["artifacts/features/&lt;slug&gt;/<br/>status · analysis · proposal · requirements review · spec<br/>plan · tasks · review · testing scenarios · promotions"]:::feature
        EXTRACTS["artifacts/features/&lt;slug&gt;/session-extracts.md<br/>candidate lessons and post-ship sync record"]:::feature
    end

    subgraph SESSION["Ephemeral Resumable State"]
        SESS[".corezero/sessions/&lt;slug&gt;/session.md<br/>objective · progress updates · handoff updates<br/>retained in place by session-end"]:::session
    end

    subgraph GENERATED["Disposable Runtime Output"]
        KEEP["corebase-specharness/generated/.gitkeep<br/>created by installer"]:::generated
        RUNS["corebase-specharness/generated/<br/>gate-runs.json · provider-runs.json · verification-runs.json<br/>latest 50 non-dry-run result sets"]:::generated
        ASSESS["corebase-specharness/generated/harness-assessment.md<br/>optional explicit harness-maintain output"]:::generated
    end

    INSTALL["install.sh<br/>backup · overwrite · seed · chmod · doctor"]:::writer
    SKILLS["11 peer skills<br/>procedure, judgment, and artifact ownership"]:::writer
    CLI["corebase-specharness CLI<br/>deterministic context, session, task,<br/>artifact, gate, diagnostic, and ADR mechanics"]:::writer

    INSTALL --> KIT_FILES
    INSTALL --> INDEX
    INSTALL --> PROJECT
    INSTALL --> MEMORY
    INSTALL --> FEATURE_README
    INSTALL --> KEEP

    SKILLS --> PROJECT
    SKILLS --> MEMORY
    SKILLS --> ART
    SKILLS --> EXTRACTS
    SKILLS --> ASSESS

    CLI --> ART
    CLI --> EXTRACTS
    CLI --> SESS
    CLI --> RUNS
    CLI --> PROJECT

    INSTALL -.->|unmatched paths remain untouched| ART
    INSTALL -.->|unmatched paths remain untouched| SESS
    INSTALL -.->|unmatched paths remain untouched| RUNS

    classDef kit fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef seed fill:#eef2ff,stroke:#6366f1,color:#312e81
    classDef memory fill:#ecfdf5,stroke:#16a34a,color:#166534
    classDef feature fill:#fef3c7,stroke:#f59e0b,color:#78350f
    classDef session fill:#f3e8ff,stroke:#9333ea,color:#4c1d95
    classDef generated fill:#f3f4f6,stroke:#9ca3af,stroke-dasharray:4 3,color:#374151
    classDef writer fill:#fff,stroke:#0d0d0d,color:#0d0d0d

    class KIT_FILES kit
    class INDEX,PROJECT,FEATURE_README seed
    class MEMORY memory
    class ART,EXTRACTS feature
    class SESS session
    class KEEP,RUNS,ASSESS generated
    class INSTALL,SKILLS,CLI writer
