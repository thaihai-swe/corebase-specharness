flowchart TD
    %% CoreBase SpecHarness Context Routing — implementation authority:
    %% ARCHITECTURE.md §3.2 / §4.4, context_engine.py, references/context-routes.yaml
    %% Palette: documents/diagrams/source/_shared/palette.md

    START(["skill-enter / context-pack / context-load / context-explain<br/>--skill &lt;name&gt;"]):::terminal
    START --> REGISTRY["references/context-routes.yaml<br/>canonical registry for 11 named skill routes"]:::core
    REGISTRY --> RESOLVE{Known skill route?}:::decision
    RESOLVE -->|No| ERROR["Fail: unknown route"]:::fail
    RESOLVE -->|Yes| FEATURE{Route feature requirement}:::decision

    FEATURE -->|required and missing| FEATURE_ERROR["Fail: --feature is required"]:::fail
    FEATURE -->|feature supplied| PREREQ{Prerequisite artifacts present?}:::decision
    FEATURE -->|optional and omitted| ASSEMBLE
    PREREQ -->|No| PREREQ_ERROR["Fail: list missing prerequisites"]:::fail
    PREREQ -->|Yes| ASSEMBLE["Assemble candidate sources"]:::core

    BASE["Always-required bootstrap<br/>corebase-specharness/memories/repo/core-policies.md Must sections"]:::gate --> ASSEMBLE
    DECLARED["Route-declared Must / Should sources<br/>and requested H2 sections"]:::core --> ASSEMBLE
    ARTIFACTS["Route-declared feature artifacts<br/>artifacts/features/&lt;slug&gt;/...<br/>.corebase-specharness/sessions/&lt;slug&gt;/session.md"]:::memory --> ASSEMBLE
    TASK["--task &lt;T-NNN&gt;<br/>bounded tasks.md excerpt"]:::memory -.-> ASSEMBLE
    EXPLICIT["repeatable --add-source<br/>validated repository-relative file"]:::external -.-> ASSEMBLE

    ASSEMBLE --> INTENT{Intent / feature / task query?}:::decision
    INTENT -->|Yes| RETRIEVE["Bounded automatic local retrieval<br/>configured roots and exclusions<br/>matching excerpts only"]:::external
    INTENT -->|No| SCORE
    RETRIEVE --> SCORE["Score and order candidates<br/>tier · keyword score · token size · path"]:::core

    SCORE --> DELTA{"Delta mode?"}:::decision
    DELTA -->|--full or no baseline| BUDGET
    DELTA -->|--delta-from or session cache| AUTO_DELTA["Session auto-delta before budget<br/>union last_context_fingerprint<br/>and last_context_slices in session.md<br/>skip unchanged files and H2 sections<br/>pass --full after compact or new chat"]:::memory
    AUTO_DELTA --> BUDGET

    CONFIG["corebase-specharness/project/harness-config.yaml<br/>profile payload · injected ceiling<br/>channel limits · retrieval limits"]:::core --> BUDGET
    BUDGET["Apply payload and channel budgets<br/>skipped delta sources do not consume caps"]:::core
    BUDGET --> MUST["Retain every Must source<br/>report mandatory overruns"]:::gate
    BUDGET --> SHOULD["Select or omit Should sources<br/>with explicit reasons"]:::core

    MUST --> PACK
    SHOULD --> PACK
    PACK["Inspectable context pack<br/>selected + omitted + delta_omitted<br/>fingerprints + slices + tokens"]:::host
    PACK --> OUTPUT
    OUTPUT[("context-pack: manifest only<br/>context-load / skill-enter: content + manifest<br/>context-explain: selection findings")]:::host

    classDef terminal fill:#111827,stroke:#111827,color:#fff
    classDef core fill:#eff6ff,stroke:#2563eb,color:#1e3a8a
    classDef gate fill:#ecfdf5,stroke:#16a34a,color:#166534
    classDef decision fill:#fff7ed,stroke:#f59e0b,color:#78350f
    classDef optional fill:#f8fafc,stroke:#94a3b8,color:#475569,stroke-dasharray:4 3
    classDef external fill:#f0f9ff,stroke:#0ea5e9,color:#0c4a6e
    classDef memory fill:#faf5ff,stroke:#a855f7,color:#4c1d95
    classDef host fill:#1e3a8a,stroke:#1e40af,color:#fff
    classDef fail fill:#fef2f2,stroke:#ef4444,color:#7f1d1d

    class START terminal
    class REGISTRY,ASSEMBLE,DECLARED,SCORE,CONFIG,BUDGET,SHOULD core
    class BASE,MUST gate
    class RESOLVE,FEATURE,PREREQ,INTENT,DELTA decision
    class RETRIEVE,EXPLICIT external
    class ARTIFACTS,TASK,AUTO_DELTA memory
    class PACK,OUTPUT host
    class ERROR,FEATURE_ERROR,PREREQ_ERROR fail
