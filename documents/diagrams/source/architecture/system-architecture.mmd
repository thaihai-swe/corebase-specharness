flowchart TB
    %% =========================================================================
    %% COREBASE SPECHARNESS KIT — SYSTEM ARCHITECTURE
    %% Implementation authority: ARCHITECTURE.md, context-routes.yaml,
    %% state-machine.yaml, cli.py, harness/readiness.py, and install.sh
    %% Palette: documents/diagrams/source/_shared/palette.md
    %% =========================================================================

    subgraph L1["Layer 1 — Direct Peer Skills and Routing"]
        AGENTS["AGENTS.md<br/>portable operating contract"]:::host
        SKILLS["skills/&lt;name&gt;/SKILL.md<br/>11 peer-level agent procedures"]:::core
        SHARED["skills/_shared/<br/>artifact · status · context · halt · handoff · verification"]:::core
        ROUTES["references/context-routes.yaml<br/>only named-skill routing authority"]:::core
        AGENT_MIRROR[".agent/skills/&lt;name&gt;/<br/>installer overwrite mirror for agent discovery"]:::optional
        EXTERNAL["EXTERNAL_SKILLS.md<br/>optional workflows outside CoreBase SpecHarness"]:::external

        AGENTS --> SKILLS
        SHARED --> SKILLS
        ROUTES --> SKILLS
        SKILLS -.->|optional specialist handoff| EXTERNAL
        SKILLS -.->|install.sh overwrite copy| AGENT_MIRROR
    end

    subgraph L2["Layer 2 — Context Compiler and Budget Engine"]
        CONTEXT["context_engine.py<br/>named-route context compiler"]:::core
        BOOTSTRAP["Always-on Must bootstrap<br/>core-policies.md"]:::gate
        DELTA["Session auto-delta<br/>session.md last_context_fingerprint<br/>SHA-256 fingerprints · --full bypass<br/>--full after compact or new chat"]:::memory
        RETRIEVE["Bounded local retrieval<br/>Must retained · Should may drop<br/>secret redaction · task excerpt"]:::external

        CONTEXT --> BOOTSTRAP
        CONTEXT --> DELTA
        CONTEXT --> RETRIEVE
    end

    subgraph L3["Layer 3 — State Machine and Task Graph"]
        MACHINE["corebase-specharness/project/state-machine.yaml<br/>kit-owned lifecycle"]:::core
        TASKS["task_graph.py<br/>T-NNN parse · cycle detect · sidecar"]:::core
        STATE["context_state.py<br/>locked atomic writes · session persist"]:::core
        HALT["[:HALT brake<br/>blocks task mutations until resolved"]:::decision

        MACHINE --> TASKS
        STATE --> TASKS
        HALT --> TASKS
    end

    subgraph L4["Layer 4 — Verification Harness and Diagnostics"]
        READY["harness/readiness.py<br/>single evaluator: phase-check · skill-exit · verify"]:::gate
        HGATES["harness/gates.py<br/>argv-safe local execution · timeout"]:::gate
        HCONFIG["harness/config.py<br/>advisory / blocking · gates · budgets"]:::core
        HDOCTOR["harness/doctor.py<br/>10 fail-capable checks + project_setup advisory"]:::core
        VERIFY["verify<br/>readiness + structure + trace + gates + review"]:::gate
        PROVIDERS["provider-list / check / run<br/>optional · never auto-enabled"]:::external

        HCONFIG --> READY
        HCONFIG --> HGATES
        READY --> VERIFY
        HGATES --> VERIFY
        PROVIDERS --> VERIFY
        HCONFIG --> HDOCTOR
    end

    subgraph L5["Layer 5 — File Stores and Persistence"]
        FEATURES["artifacts/features/&lt;slug&gt;/<br/>status · analysis · spec · plan · tasks<br/>review · session-extracts · testing scenarios"]:::memory
        SESSIONS[".corebase-specharness/sessions/&lt;slug&gt;/session.md<br/>ephemeral resumable state"]:::optional
        MEMORY["corebase-specharness/memories/ · corebase-specharness/project/<br/>durable repo and domain knowledge"]:::memory
        MANIFEST["manifest.json<br/>overwrite · copyIfMissing"]:::core
        INSTALL["corebase-specharness/scripts/install.sh<br/>backup · overwrite · seed · .agent/skills · chmod · doctor"]:::core
        CLI["corebase-specharness/scripts/core/cli.py<br/>flat command registry · normalized envelope"]:::agent
        BACKUP[".corezero-backup-&lt;random&gt;/<br/>mktemp overwrite backup · not gitignored"]:::optional

        INSTALL --> MANIFEST
        INSTALL --> BACKUP
        MANIFEST --> FEATURES
        MANIFEST --> MEMORY
        CLI --> SESSIONS
    end

    SKILLS -->|skill-enter / skill-exit| CLI
    CLI --> CONTEXT
    CLI --> TASKS
    CLI --> READY
    ROUTES --> CONTEXT
    VERIFY --> FEATURES
    TASKS --> FEATURES
    STATE --> SESSIONS
    HDOCTOR --> MANIFEST

    classDef terminal fill:#111827,stroke:#111827,color:#fff
    classDef core fill:#eff6ff,stroke:#2563eb,color:#1e3a8a
    classDef gate fill:#ecfdf5,stroke:#16a34a,color:#166534
    classDef decision fill:#fff7ed,stroke:#f59e0b,color:#78350f
    classDef optional fill:#f8fafc,stroke:#94a3b8,color:#475569,stroke-dasharray:4 3
    classDef external fill:#f0f9ff,stroke:#0ea5e9,color:#0c4a6e,stroke-dasharray:4 3
    classDef memory fill:#faf5ff,stroke:#a855f7,color:#4c1d95
    classDef host fill:#1e3a8a,stroke:#1e40af,color:#fff
    classDef agent fill:#475569,stroke:#334155,color:#fff

    class AGENTS host
    class SKILLS,SHARED,ROUTES,CONTEXT,MACHINE,TASKS,STATE,HCONFIG,HDOCTOR,MANIFEST,INSTALL core
    class BOOTSTRAP,READY,HGATES,VERIFY gate
    class HALT decision
    class AGENT_MIRROR,SESSIONS,BACKUP optional
    class EXTERNAL,PROVIDERS,RETRIEVE external
    class DELTA,FEATURES,MEMORY memory
    class CLI agent
